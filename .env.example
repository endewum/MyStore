# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# --- Telegram --------------------------------------------------------------
# Token issued by @BotFather.
BOT_TOKEN=123456789:replace-with-your-bot-token
# Comma separated Telegram user IDs promoted to SUPER_ADMIN on startup.
BOT_ADMIN_IDS=
# Optional: username of the main administrator, used for display only.
BOT_ADMIN_USERNAME=
BOT_PARSE_MODE=HTML
# Drop updates that arrived while the bot was offline.
BOT_SKIP_UPDATES=true

# --- Database (MySQL 8+) ---------------------------------------------------
# Must use an async driver: mysql+aiomysql:// (or sqlite+aiosqlite:// in tests).
DB_URL=mysql+aiomysql://store:store@localhost:3306/telegram_store
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (optional) ------------------------------------------------------
# Only needed to keep FSM state across restarts or to run several instances.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# --- Webhook (optional; long polling is used when disabled) ----------------
WEBHOOK_ENABLED=false
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- Storefront ------------------------------------------------------------
STORE_NAME=Digital Store
STORE_CURRENCY=USD
# 3 columns x 9 rows per storefront page.
STORE_PRODUCTS_PER_PAGE=27
STORE_PRODUCT_GRID_COLUMNS=3
STORE_PLANS_PER_PAGE=8
STORE_ORDERS_PER_PAGE=5
STORE_NOTIFICATIONS_PER_PAGE=5
STORE_ADMIN_LIST_PAGE_SIZE=8
# Minutes an unpaid order keeps its reserved stock.
STORE_PAYMENT_TIMEOUT_MINUTES=60
STORE_SUPPORT_USERNAME=
# Telegram allows roughly 30 messages/second; stay below it.
STORE_BROADCAST_MESSAGES_PER_SECOND=20
STORE_BROADCAST_BATCH_SIZE=25

# --- Security --------------------------------------------------------------
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_INTERVAL=0.45
SECURITY_RATE_LIMIT_BURST=5
# Reserved for future signed admin actions.
SECURITY_ADMIN_SECRET=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# ---------------------------------------------------------------------------
# Payment credentials (Binance / Bybit / USDT) are NOT configured here.
# They live in the database and are managed from the admin panel:
#   /admin -> Payment methods
# ---------------------------------------------------------------------------
